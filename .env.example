# minty-payment-request-api (port 8020)

# "development" turns on DEBUG; anything else (default) is production, which refuses
# to start with the placeholder SECRET_KEY.
APP_ENV=development
# Shared with the Petty Cash (Flask) app: verifies the tokens it mints and signs calls
# to its internal Xero token endpoint.
SECRET_KEY=replace-me-shared-with-flask
ALLOWED_HOSTS=*

# Same database as Petty Cash. ?schema= sets search_path (default pettycashv3); any other
# query parameter (sslmode=require, ...) goes to the driver.
DATABASE_URL=postgresql://minty_ref_user:minty_ref_pass@localhost:5432/minty_ref?schema=pettycashv3

# Attachment bucket (Backblaze B2, S3 API): https://KEY:SECRET@s3.<region>.backblazeb2.com/<bucket>
# Percent-encode the key/secret if they contain / + @ :
S3_URL=https://your-key-id:your-secret@s3.your-region.backblazeb2.com/your-bucket-name

# Petty Cash (Flask). Also the Xero token service: PETTY_CASH_URL/api/internal/xero/token.
# Xero OAuth credentials are deliberately NOT configured here: Xero refresh tokens are
# single-use, and the Flask app is the only service allowed to refresh them.
PETTY_CASH_URL=http://localhost:8010
# Payment Request web (landing redirect target, CORS)
PAYMENT_REQUEST_WEB_URL=http://localhost:3020
# Onboarding web (CORS)
ONBOARDING_WEB_URL=http://localhost:3030

# Optional
# CORS_ALLOWED_ORIGINS=http://localhost:3020,http://localhost:3030   # default: the two web URLs above
# LOG_LEVEL=INFO
# RUN_MIGRATIONS=true      # docker/entrypoint.sh
# DB_WAIT_SECONDS=180      # docker/entrypoint.sh

# Django
DJANGO_SETTINGS_MODULE=config.settings
SECRET_KEY=replace-me-shared-with-flask
DEBUG=True
ALLOWED_HOSTS=*

# Database (same as Flask Module 1)
POSTGRES_DB=minty_ref
POSTGRES_USER=minty_ref_user
POSTGRES_PASSWORD=minty_ref_pass
DB_HOST=localhost
DB_PORT=5432

# S3 / Backblaze (for attachment uploads)
S3_BUCKET=your-bucket-name
S3_KEY=your-s3-key-id
S3_REGION=your-s3-region
S3_SECRET=your-s3-secret
S3_ENDPOINT_URL=https://s3.your-region.backblazeb2.com

# Xero OAuth — intentionally NOT set here.
#
# Do not add XERO_CLIENT_ID / XERO_CLIENT_SECRET to this service. Xero rotates
# refresh tokens on every use and invalidates the old one immediately. The Flask
# app (Module 1) is the sole refresher and persists tokens for billing to read.
# Giving billing credentials makes it a second refresher: both services would POST
# the same single-use refresh token, one would get 400 invalid_grant, and the Xero
# connection would stay broken until the user manually reconnects.
#
# If billing needs a fresh token, it must ask the Flask app for one.

# Flask Module 1 URL (for cross-module redirect)
FLASK_APP_URL=http://localhost:5001

# Flask app's internal Xero token endpoint. Defaults to FLASK_APP_URL +
# /api/internal/xero/token. Authenticated with the shared SECRET_KEY.
# Returns live Xero access tokens — must not be routable from the public internet.
XERO_TOKEN_SERVICE_URL=http://localhost:5001/api/internal/xero/token
XERO_TOKEN_SERVICE_TIMEOUT=15

# Module 2 Frontend URL
FRONTEND_APP_URL=http://localhost:3000
